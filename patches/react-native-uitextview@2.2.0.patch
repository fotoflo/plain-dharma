+// Suppress the native iOS edit menu (Copy / Look Up / Translate) on selection.
+// Plain Dharma drives its own floating toolbar (Highlight / Note / Copy / Share)
+// off onSelectionChange, so the native callout is a duplicate. Returning a menu
+// with no children hides the callout while keeping the selection, grabbers, and
+// loupe intact. (iOS 16+; earlier versions have no edit-menu delegate hook.)
+- (UIMenu *)textView:(UITextView *)textView editMenuForTextInRange:(NSRange)range suggestedActions:(NSArray<UIMenuElement *> *)suggestedActions API_AVAILABLE(ios(16.0))
+{
+  return [UIMenu menuWithChildren:@[]];
+}
