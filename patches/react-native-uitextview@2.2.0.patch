@@ -320,6 +320,25 @@ using namespace facebook::react;
     return;
   }
 
+  // Selection bounding rect in WINDOW coordinates (points) so JS can anchor a
+  // floating toolbar over the selection (web position:fixed parity). The union
+  // of the per-line selection rects, converted from the text view's space to the
+  // window. Empty/zero when nothing is selected.
+  CGRect selectionRect = CGRectZero;
+  UITextRange *textRange = textView.selectedTextRange;
+  if (textRange != nil && !textRange.empty) {
+    NSArray<UITextSelectionRect *> *rects = [textView selectionRectsForRange:textRange];
+    for (UITextSelectionRect *r in rects) {
+      if (r.rect.size.width == 0 && r.rect.size.height == 0) {
+        continue;
+      }
+      selectionRect = CGRectIsEmpty(selectionRect) ? r.rect : CGRectUnion(selectionRect, r.rect);
+    }
+    if (!CGRectIsEmpty(selectionRect)) {
+      selectionRect = [textView convertRect:selectionRect toView:nil];
+    }
+  }
+
   // Fires on programmatic selection changes too (e.g. the outside-tap clear
   // in handleOutsideTap:), so JS will see a synthetic empty-range event then.
   std::dynamic_pointer_cast<const facebook::react::RNUITextViewEventEmitter>(_eventEmitter)
@@ -327,9 +346,23 @@ using namespace facebook::react;
       static_cast<int>(self.tag),
       static_cast<int>(selectedRange.location),
       static_cast<int>(selectedRange.location + selectedRange.length),
+      static_cast<double>(selectionRect.origin.x),
+      static_cast<double>(selectionRect.origin.y),
+      static_cast<double>(selectionRect.size.width),
+      static_cast<double>(selectionRect.size.height),
     });
 }
 
+// Suppress the native iOS edit menu (Copy / Look Up / Translate) on selection.
+// Plain Dharma drives its own floating toolbar (Highlight / Note / Copy / Share)
+// off onSelectionChange, so the native callout is a duplicate. Returning a menu
+// with no children hides the callout while keeping the selection, grabbers, and
+// loupe intact. (iOS 16+; earlier versions have no edit-menu delegate hook.)
+- (UIMenu *)textView:(UITextView *)textView editMenuForTextInRange:(NSRange)range suggestedActions:(NSArray<UIMenuElement *> *)suggestedActions API_AVAILABLE(ios(16.0))
+{
+  return [UIMenu menuWithChildren:@[]];
+}
